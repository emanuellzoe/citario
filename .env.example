# Optional: price inside a TEE on NEAR AI Cloud. Without it the facilitator uses
# a local pricer and every receipt says attested: false.
# Key: https://cloud.near.ai (or $10 of credits via https://nearbuilders.org/dashboard)
NEARAI_API_KEY=
NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Optional overrides
NEAR_RPC_URL=https://test.rpc.fastnear.com
FACILITATOR_URL=http://localhost:8787

# Everything below is written by `pnpm run setup:testnet` (fresh faucet accounts on testnet).
CITARIO_CONTRACT_ID=
FACILITATOR_SECRET=
ARTICLE_KEY_HEX=
AUTHOR_ACCOUNT_ID=
READER_ACCOUNT_ID=
READER_PRIVATE_KEY=
READER2_ACCOUNT_ID=
READER2_PRIVATE_KEY=
